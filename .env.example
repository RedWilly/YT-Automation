###############################################################################
#                                 CORE SETTINGS                               #
###############################################################################

# Telegram Bot Token
# Get this from @BotFather on Telegram: https://t.me/botfather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Access Control (optional)
# Leave both empty to allow everyone.
# Comma-separated numeric IDs. Find yours: message @userinfobot on Telegram
# Group IDs start with -100. Find group ID: add @getidsbot to the group
ALLOWED_USER_IDS=
ALLOWED_CHAT_IDS=

# Debug Mode
# true = detailed logs (useful for development)
# false = lite logs (recommended for production)
DEBUG=false


###############################################################################
#                           TRANSCRIPTION SERVICE                             #
###############################################################################

# AssemblyAI API Key (Required)
# Sign up at https://www.assemblyai.com/ - Free tier: 5 hours/month
ASSEMBLYAI_API_KEY=your_assemblyai_key_here


###############################################################################
#                           LLM PROVIDER CONFIGURATION                        #
###############################################################################

# Select LLM Provider for generating image queries
# Options: "deepseek" (recommended, affordable) or "kimi"
AI_PROVIDER=deepseek

# DeepSeek API Key (Required if AI_PROVIDER=deepseek)
# Sign up at https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Kimi API Key (Required if AI_PROVIDER=kimi)
# Sign up at https://platform.moonshot.cn/
KIMI_API_KEY=your_kimi_api_key_here

# LLM Batch Size
# For long transcripts, segments are batched to avoid model limits
# Reduce to 40 if you see errors or partial outputs
LLM_SEGMENTS_PER_BATCH=60


###############################################################################
#                           IMAGE GENERATION                                  #
###############################################################################

# Enable AI Image Generation
# true = Generate images with AI (uses provider below)
# false = Search web for images via DuckDuckGo
USE_AI_IMAGE=false

# AI Image Provider Selection
# Options: "cloudflare" | "togetherai" | "imagefx"
# - cloudflare: Stable Diffusion XL via Cloudflare Worker (free tier available)
# - togetherai: FLUX.1-schnell model (free tier: 6 img/min rate limited)
# - imagefx: Google IMAGEN 3.5 (requires Google cookie)
AI_IMAGE_MODEL=cloudflare

# --------------------------
# Cloudflare Worker (AI_IMAGE_MODEL=cloudflare)
# --------------------------
# Deploy worker: see cloudflarework.js and SETUP.md for tutorial
WORKER_API_URL=https://worker_name.username.workers.dev/
WORKER_API_KEY=your_worker_api_key_here

# --------------------------
# Together AI (AI_IMAGE_MODEL=togetherai)
# --------------------------
# Sign up at https://www.together.ai/
# Free tier: 6 images/minute (rate limiting handled automatically)
TOGETHER_API_KEY=your_together_api_key_here

# --------------------------
# ImageFX / Google IMAGEN (AI_IMAGE_MODEL=imagefx)
# --------------------------
# Uses Google's IMAGEN 3.5 model via ImageFX
# Get cookie from https://labs.google/fx/tools/image-fx (inspect network requests)
GOOGLE_COOKIE=your_google_cookie_here


###############################################################################
#                           STORAGE CONFIGURATION                             #
###############################################################################

# MinIO Object Storage (Optional)
# Used to upload finished videos for downstream processing (e.g., YouTube via n8n)
# Set to false to keep videos local only
PRODUCTION=false
MINIO_ENDPOINT=https://your-minio-endpoint.com
MINIO_ACCESS_KEY=your_minio_access_key_here
MINIO_SECRET_KEY=your_minio_secret_key_here
MINIO_BUCKET=finished-videos
MINIO_REGION=us-east-1
